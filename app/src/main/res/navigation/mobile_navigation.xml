<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/nav_inicio">
    <fragment
        android:id="@+id/nav_inicio"
        android:name="com.debora.inmobiliaria.ui.inicio.InicioFragment"
        android:label="Inicio"
        tools:layout="@layout/fragment_inicio" />
    <fragment
        android:id="@+id/nav_perfil"
        android:name="com.debora.inmobiliaria.ui.perfil.PerfilFragment"
        android:label="Perfil"
        tools:layout="@layout/fragment_perfil" >
        <action
            android:id="@+id/action_nav_perfil_to_perfilEditarContrasenaFragment"
            app:destination="@id/perfilEditarContrasenaFragment" />
    </fragment>
    <fragment
        android:id="@+id/nav_inmuebles"
        android:name="com.debora.inmobiliaria.ui.inmuebles.InmueblesFragment"
        android:label="Inmuebles"
        tools:layout="@layout/fragment_inmuebles" >
        <action
            android:id="@+id/action_nav_inmuebles_to_inmuebleDetalleFragment"
            app:destination="@id/inmuebleDetalleFragment" />
        <action
            android:id="@+id/action_nav_inmuebles_to_inmuebleCargarFragment"
            app:destination="@id/inmuebleCargarFragment" />
    </fragment>
    <fragment
        android:id="@+id/nav_inquilinos"
        android:name="com.debora.inmobiliaria.ui.inquilinos.InquilinosFragment"
        android:label="Inquilinos"
        tools:layout="@layout/fragment_inquilinos" />
    <fragment
        android:id="@+id/nav_contratos"
        android:name="com.debora.inmobiliaria.ui.contratos.ContratosFragment"
        android:label="Contratos"
        tools:layout="@layout/fragment_contratos" >
        <action
            android:id="@+id/action_nav_contratos_to_contratoDetalleFragment22"
            app:destination="@id/contratoDetalleFragment2" />
    </fragment>
    <fragment
        android:id="@+id/nav_logout"
        android:name="com.debora.inmobiliaria.ui.logout.LogoutFragment"
        android:label="Logout"
        tools:layout="@layout/fragment_logout" />
    <fragment
        android:id="@+id/perfilEditarContrasenaFragment"
        android:name="com.debora.inmobiliaria.ui.perfil.PerfilEditarContrasenaFragment"
        android:label="Cambiar contrasenia"
        tools:layout="@layout/fragment_perfil_editar_contrasena" >
        <action
            android:id="@+id/action_perfilEditarContrasenaFragment_to_nav_perfil"
            app:destination="@id/nav_perfil" />
    </fragment>
    <fragment
        android:id="@+id/inmuebleDetalleFragment"
        android:name="com.debora.inmobiliaria.ui.inmuebles.InmuebleDetalleFragment"
        android:label="Informacion del inmueble"
        tools:layout="@layout/fragment_inmueble_detalle" />
    <fragment
        android:id="@+id/inmuebleCargarFragment"
        android:name="com.debora.inmobiliaria.ui.inmuebles.InmuebleCargarFragment"
        android:label="Cargar nuevo inmueble"
        tools:layout="@layout/fragment_inmueble_cargar" >
        <action
            android:id="@+id/action_inmuebleCargarFragment_to_nav_inmuebles"
            app:destination="@id/nav_inmuebles" />
    </fragment>
    <fragment
        android:id="@+id/contratoDetalleFragment2"
        android:name="com.debora.inmobiliaria.ui.contratos.ContratoDetalleFragment"
        android:label="Contrato actual"
        tools:layout="@layout/fragment_contrato_detalle" >
        <action
            android:id="@+id/action_contratoDetalleFragment2_to_nav_contratos"
            app:destination="@id/nav_contratos" />
        <action
            android:id="@+id/action_contratoDetalleFragment2_to_pagosFragment"
            app:destination="@id/pagosFragment" />
    </fragment>
    <fragment
        android:id="@+id/pagosFragment"
        android:name="com.debora.inmobiliaria.ui.Pagos.PagosFragment"
        android:label="Pagos"
        tools:layout="@layout/fragment_pagos" >
    </fragment>
</navigation>